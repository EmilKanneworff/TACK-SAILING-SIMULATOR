# Vercel build environment (Production and Preview).
# The browser connects to this URL over TLS. Leave blank for local HTTP.
VITE_REALTIME_URL=

# Node live service. Render supplies PORT automatically.
HOST=0.0.0.0
PORT=3001
# Optional comma-separated exact web origins, including approved previews.
TACK_WEB_ORIGINS=
# Use the provider's forwarded client address only behind its reverse proxy.
TACK_TRUST_PROXY=0
